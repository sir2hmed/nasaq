APP_NAME="Nasaq AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
FRONTEND_URL=http://localhost:5173
NASAQ_DEMO_MODE=true
HEALTH_CHECK_DEPENDENCIES=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nasaq
DB_USERNAME=nasaq
DB_PASSWORD=local-only-change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=nasaq-session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TOKEN=replace-with-a-long-random-token
AI_SERVICE_TIMEOUT_SECONDS=15
INTERNAL_CALLBACK_BASE_URL=http://laravel:8000/api/internal
INTERNAL_CALLBACK_TOKEN=replace-with-a-different-long-random-token

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@nasaq.example"
MAIL_FROM_NAME="${APP_NAME}"
