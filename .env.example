COMPOSE_PROJECT_NAME=nasaq-ai
APP_ENV=local
NASAQ_DEMO_MODE=true

POSTGRES_DB=nasaq
POSTGRES_USER=nasaq
POSTGRES_PASSWORD=change-me-for-non-local-use

REDIS_PORT=6379
FRONTEND_PORT=5173
LARAVEL_PORT=8000
AI_SERVICE_PORT=8001
APP_KEY=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000
SESSION_COOKIE=nasaq-session

AI_SERVICE_TOKEN=replace-with-a-long-random-token
INTERNAL_CALLBACK_TOKEN=replace-with-a-different-long-random-token

# Laravel Admin configuration is authoritative for real LLM workflow execution.
# The worker requests an execution-only provider resolution over the internal service token.
# Environment provider keys are bootstrap/development-only and cannot silently override Admin configuration.
PROVIDER_RESOLUTION_TIMEOUT_SECONDS=10
ALLOW_ENVIRONMENT_PROVIDER_FALLBACK=false

# Real runs use these server-side provider settings. Demo runs never require them.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.6
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_TIMEOUT_SECONDS=60
INTEGRATION_TIMEOUT_SECONDS=15
GOOGLE_DRIVE_UPLOAD_URL=https://www.googleapis.com/upload/drive/v3/files
YOUTUBE_UPLOAD_URL=https://www.googleapis.com/upload/youtube/v3/videos
SIDE_EFFECT_IDEMPOTENCY_TTL_SECONDS=604800
