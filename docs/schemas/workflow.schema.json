{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasaq.example/schemas/workflow-v1.json",
  "title": "Nasaq AI workflow graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "nodes", "edges"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": ["string", "null"], "maxLength": 2000 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "y": { "type": "number", "minimum": -100000, "maximum": 100000 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "position", "config"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "type": {
          "enum": [
            "researcher",
            "writer",
            "export",
            "video",
            "approval",
            "publisher",
            "email"
          ]
        },
        "position": { "$ref": "#/$defs/position" },
        "config": { "type": "object" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        }
      }
    }
  }
}

