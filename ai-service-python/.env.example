APP_ENV=local
DEMO_MODE=true
HOST=0.0.0.0
PORT=8001
ARTIFACT_ROOT=artifacts

REDIS_URL=redis://redis:6379/0
CHECK_DEPENDENCIES=true
ALLOWED_ORIGINS=["http://localhost:5173"]
LARAVEL_CALLBACK_BASE_URL=http://laravel:8000/api/internal
LARAVEL_CALLBACK_TOKEN=replace-with-a-different-long-random-token
PROVIDER_RESOLUTION_TIMEOUT_SECONDS=10
# Production uses Laravel's service-token-protected provider resolution. Never set this true in production.
ALLOW_ENVIRONMENT_PROVIDER_FALLBACK=false
AI_SERVICE_TOKEN=replace-with-a-long-random-token
CALLBACK_TIMEOUT_SECONDS=10
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=5
RETRY_JITTER_RATIO=0.25
CANCELLATION_TTL_SECONDS=86400

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.6
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
OPENAI_BASE_URL=https://api.openai.com/v1
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
PROVIDER_TIMEOUT_SECONDS=60
INTEGRATION_TIMEOUT_SECONDS=15
GOOGLE_DRIVE_UPLOAD_URL=https://www.googleapis.com/upload/drive/v3/files
YOUTUBE_UPLOAD_URL=https://www.googleapis.com/upload/youtube/v3/videos
SIDE_EFFECT_IDEMPOTENCY_TTL_SECONDS=604800

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_SMTP_HOST=
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_PASSWORD=
